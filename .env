# ==========================================================================
# .env.example — Phase 4.1 CMS foundation
#
# Copy this file to ".env" (same folder, one level above public_html) and
# fill in real values there. ".env" itself must NEVER be committed to
# version control or uploaded anywhere web-accessible.
# ==========================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://portofolio.mohamadlingga.my.id

# ---- Database ----
# Default driver: sqlite (zero-config, no separate DB server required).
# Good fit for shared hosting where a dedicated MySQL service may not be
# available or configured yet.
#DB_DRIVER=sqlite
#DB_SQLITE_PATH=../storage/portfolio.sqlite

# To use MySQL instead, uncomment and fill these in, then set DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mohlinggamy_portofolio
DB_USER=mohlinggamy_portofolio
DB_PASS=*lingga_porto1117994

# ---- Admin session ----
SESSION_NAME=portfolio_admin_sess
SESSION_LIFETIME=1800

# ---- One-time browser setup (public_html/admin/setup.php) ----
# Only needed if you have no SSH/terminal access and must run the initial
# migration + create the first admin through the browser instead of the
# CLI scripts. Set this to a long random string (32+ characters, your own
# choice — mash the keyboard or use a password generator) BEFORE opening
# setup.php. Leave it blank if you have SSH access and don't need this.
SETUP_TOKEN=x7Kp2mQzR9vLwT4nB8sYcF1hJd6eA3gU 
