# ==========================================================================
# Project-root .htaccess — defense in depth.
#
# public_html/ is the intended document root; config/, app/, database/,
# and storage/ sit OUTSIDE it and should never be reachable over HTTP at
# all. This file only matters if a hosting misconfiguration ever points
# the web server at this folder instead of public_html/ — in that case,
# deny everything outright.
# ==========================================================================
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
